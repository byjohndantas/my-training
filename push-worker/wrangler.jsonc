{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-training-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_HUB",
        "class_name": "PushHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PushHub"
      ]
    }
  ]
}
